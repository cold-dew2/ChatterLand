DB_URL=jdbc:mariadb://localhost:3306/chatterland?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul
DB_USERNAME=ctland
DB_PASSWORD=replace-with-your-local-database-password
DB_POOL_SIZE=10
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUDIO_STORAGE_PATH=./storage/audio
AI_CONNECT_TIMEOUT=5s
AI_READ_TIMEOUT=60s
AI_API_URL=
AI_API_KEY=
SPEECH_API_URL=
SPEECH_API_KEY=

# 로컬 음성 인식(whisper.cpp). 비워 두면 application.properties 기본값을 사용합니다.
SPEECH_ENGINE=local
WHISPER_CLI_PATH=
WHISPER_MODEL_PATH=
WHISPER_THREADS=4

# 비밀번호 재설정 메일 (개발: mailpit → MAIL_HOST=localhost, MAIL_PORT=1025, MAIL_FROM=no-reply@chatterland.local)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=

# 아동 음성 파일 보관 기간(개월). 동의 안내문·기관 정책과 일치해야 한다.
AUDIO_RETENTION_MONTHS=6
