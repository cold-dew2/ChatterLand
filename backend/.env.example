DB_URL=jdbc:mariadb://localhost:3306/chatterland?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul
DB_USERNAME=ctland
DB_PASSWORD=replace-with-your-local-database-password
DB_POOL_SIZE=10
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# access token 수명(ms). 권장 15~30분(900000~1800000). 기본 30분.
JWT_EXPIRATION_MS=1800000
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUDIO_STORAGE_PATH=./storage/audio
AI_CONNECT_TIMEOUT=5s
AI_READ_TIMEOUT=60s
# AI 대화: OpenAI 호환 Chat Completions 전체 URL(예: 제공자의 .../v1/chat/completions), 키, 모델명
# 비어 있으면 AI 대화는 503으로 응답한다. 키는 백엔드에만 두고 NEXT_PUBLIC_ 변수로 만들지 않는다.
AI_API_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
SPEECH_API_URL=
SPEECH_API_KEY=

# 로컬 음성 인식(whisper.cpp). 경로를 바꿀 때만 주석을 풀고 값을 넣으세요.
# 값이 빈 줄(WHISPER_MODEL_PATH=)은 기본값 대신 빈 경로로 적용되므로 그대로 두면 안 됩니다.
SPEECH_ENGINE=local
# WHISPER_CLI_PATH=/opt/homebrew/bin/whisper-cli
# WHISPER_MODEL_PATH=/path/to/ggml-large-v3-turbo-q5_0.bin
WHISPER_THREADS=4
# 말소리 확인(Silero VAD). 기본 경로: ~/.cache/chatterland/whisper/ggml-silero-v5.1.2.bin
# WHISPER_VAD_CLI_PATH=/opt/homebrew/bin/whisper-vad-speech-segments
# WHISPER_VAD_MODEL_PATH=/path/to/ggml-silero-v5.1.2.bin

# 비밀번호 재설정 메일 (개발: mailpit → MAIL_HOST=localhost, MAIL_PORT=1025, MAIL_FROM=no-reply@chatterland.local)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=

# 아동 음성 파일 보관 기간(개월). 동의 안내문·기관 정책과 일치해야 한다.
AUDIO_RETENTION_MONTHS=6
